# Local-only Oracle APEX development-loop example configuration.
# Copy these values into your shell session or a separate uncommitted local env file.

OPENCODE_APEX_DEVLOOP_ENABLED=1
OPENCODE_APEX_DEVLOOP_WORKSPACE_ROOT=C:\Users\name\source\repos\oracle-apex-workspace
OPENCODE_APEX_DEVLOOP_ENVIRONMENT=dev
OPENCODE_APEX_DEVLOOP_SQLCL_PROFILE=local-apex-dev
OPENCODE_APEX_DEVLOOP_APPLICATION_ID=100
OPENCODE_APEX_DEVLOOP_SOURCE_PATH=src/apex
OPENCODE_APEX_DEVLOOP_DEPLOYMENT_PROFILE=development
OPENCODE_APEX_DEVLOOP_BUILDER_URL=https://example.test/ords/r/apex/app-builder/home?session=LOCAL
OPENCODE_APEX_DEVLOOP_APPLICATION_URL=https://example.test/ords/r/demo/home

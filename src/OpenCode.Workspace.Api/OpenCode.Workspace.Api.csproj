<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OpenCode.Workspace.LocalHost</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="XtermBlazor" GeneratePathProperty="true" ExcludeAssets="all" />
    <ProjectReference Include="..\OpenCode.Workspace.AppSupport\OpenCode.Workspace.AppSupport.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Core\OpenCode.Workspace.Core.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.LocalClient\OpenCode.Workspace.LocalClient.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Mcp\OpenCode.Workspace.Mcp.csproj" AdditionalProperties="OutputType=Library" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\catalog\**\*">
      <Link>catalog\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgXtermBlazor)\staticwebassets\XtermBlazor.min.js" LogicalName="OpenCode.Workspace.LocalHost.WebAssets.xterm.js" />
    <EmbeddedResource Include="$(PkgXtermBlazor)\staticwebassets\XtermBlazor.min.css" LogicalName="OpenCode.Workspace.LocalHost.WebAssets.xterm.css" />
  </ItemGroup>

</Project>

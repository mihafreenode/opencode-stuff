<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>opencode-workspace-api</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenCode.Workspace.AppSupport\OpenCode.Workspace.AppSupport.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Core\OpenCode.Workspace.Core.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.LocalClient\OpenCode.Workspace.LocalClient.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Mcp\OpenCode.Workspace.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\catalog\**\*">
      <Link>catalog\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

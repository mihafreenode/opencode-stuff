<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenCode.Workspace.Avalonia.RecoveryConfirmationWindow"
        Width="620"
        Height="420"
        MinWidth="560"
        MinHeight="340"
        Title="Recover Workspace"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="20">
    <StackPanel Spacing="6">
      <TextBlock x:Name="TitleTextBlock" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="SummaryTextBlock" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#D6D9DF" BorderThickness="1" CornerRadius="10" Padding="12">
      <StackPanel Spacing="6">
        <TextBlock Text="Findings" FontWeight="SemiBold" />
        <ItemsControl x:Name="FindingsItemsControl" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock x:Name="ConfirmationTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Cancel" Click="CancelClicked" />
      <Button Grid.Column="2" Classes="accent" Content="Recover" Click="ConfirmClicked" />
    </Grid>
  </Grid>
</Window>

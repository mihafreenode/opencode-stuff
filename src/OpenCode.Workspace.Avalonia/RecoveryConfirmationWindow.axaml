<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="OpenCode.Workspace.Avalonia.RecoveryConfirmationWindow"
        Width="760"
        Height="680"
        MinWidth="700"
        MinHeight="620"
        Title="Recover Workspace"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="20">
    <StackPanel Spacing="6">
      <TextBlock Text="Recover Workspace" FontSize="24" FontWeight="SemiBold" automation:AutomationProperties.Name="Recover Workspace" />
      <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
        <TextBlock Text="Workspace" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Column="1" x:Name="WorkspaceNameTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" />
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
      <Border Classes="panel-subtle">
        <StackPanel Spacing="6">
          <TextBlock x:Name="StatusTextBlock" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="SummaryTextBlock" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Recover will:" FontWeight="SemiBold" />
          <ItemsControl x:Name="RecoverActionsItemsControl" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Detected problems" FontWeight="SemiBold" />
          <ItemsControl x:Name="DetectedProblemsItemsControl" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Recover will NOT:" FontWeight="SemiBold" />
          <ItemsControl x:Name="WillNotItemsControl" />
        </StackPanel>
      </Border>

      <Border Grid.Row="4" x:Name="ManualActionBorder" Classes="panel-subtle" IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock Text="Possible manual action" FontWeight="SemiBold" />
          <TextBlock x:Name="ManualActionOverviewTextBlock" TextWrapping="Wrap" />
          <ItemsControl x:Name="ManualActionsItemsControl" />
        </StackPanel>
      </Border>

      <Expander Grid.Row="5" x:Name="AdvancedDetailsExpander" Header="Show Details" automation:AutomationProperties.Name="Show Details">
        <Border Margin="0,8,0,0" Classes="panel">
          <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="AdvancedDetailsTextBlock" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono, monospace" />
          </ScrollViewer>
        </Border>
      </Expander>
    </Grid>

    <Border Grid.Row="2" Classes="dialog-footer">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock x:Name="ConfirmationTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Cancel" IsCancel="True" Click="CancelClicked" automation:AutomationProperties.Name="Cancel Recover Workspace" />
        <Button Grid.Column="2" Classes="accent" Content="Recover Workspace" IsDefault="True" Click="ConfirmClicked" automation:AutomationProperties.Name="Recover Workspace Confirm" />
      </Grid>
    </Border>
  </Grid>
</Window>

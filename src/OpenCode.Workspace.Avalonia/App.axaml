<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenCode.Workspace.Avalonia.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://OpenCode.Workspace.Avalonia/Resources/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OpenCode.Workspace.Avalonia/Resources/Colors.axaml" />
        <ResourceInclude Source="avares://OpenCode.Workspace.Avalonia/Resources/Spacing.axaml" />
        <ResourceInclude Source="avares://OpenCode.Workspace.Avalonia/Resources/Typography.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>

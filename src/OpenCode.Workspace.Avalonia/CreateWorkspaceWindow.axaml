<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenCode.Workspace.Avalonia.CreateWorkspaceWindow"
        Width="640"
        Height="420"
        MinWidth="560"
        MinHeight="360"
        Title="Create Workspace"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="20">
    <StackPanel Spacing="6">
      <TextBlock Text="Create Workspace" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Choose a template, workspace name, and destination folder." TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="Template" FontWeight="SemiBold" />
        <ComboBox x:Name="TemplateComboBox">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Workspace name" FontWeight="SemiBold" />
        <TextBox x:Name="WorkspaceNameTextBox" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Destination folder" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="WorkspacePathTextBox" />
          <Button Grid.Column="1" Content="Browse" Click="BrowseWorkspaceFolder" />
        </Grid>
      </StackPanel>
      <Border BorderBrush="#D6D9DF" BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Template summary" FontWeight="SemiBold" />
          <TextBlock x:Name="TemplateSummaryTextBlock" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="ValidationMessageTextBlock" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Cancel" Click="CancelClicked" />
      <Button Grid.Column="2" Content="Create" Classes="accent" Click="CreateClicked" />
    </Grid>
  </Grid>
</Window>

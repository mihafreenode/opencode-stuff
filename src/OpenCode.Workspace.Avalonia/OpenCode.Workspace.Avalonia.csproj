<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>opencode-workspace</AssemblyName>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\docs\images\opencode-stuff-satchel-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenCode.Workspace.AppSupport\OpenCode.Workspace.AppSupport.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Core\OpenCode.Workspace.Core.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Platform\OpenCode.Workspace.Platform.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Platform.Linux\OpenCode.Workspace.Platform.Linux.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Platform.MacOS\OpenCode.Workspace.Platform.MacOS.csproj" />
    <ProjectReference Include="..\OpenCode.Workspace.Platform.Windows\OpenCode.Workspace.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\docs\images\opencode-stuff-satchel-icon.png">
      <Link>Assets\opencode-stuff-satchel-icon.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="..\..\docs\images\opencode-stuff-satchel-icon.ico">
      <Link>Assets\opencode-stuff-satchel-icon.ico</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="..\..\docs\images\opencode-stuff-header-brand-ui.png">
      <Link>Assets\opencode-stuff-header-brand-ui.png</Link>
    </AvaloniaResource>
    <AvaloniaResource Include="..\..\docs\images\opencode-stuff-satchel-transparent.png">
      <Link>Assets\opencode-stuff-satchel-transparent.png</Link>
    </AvaloniaResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\catalog\**\*.yaml">
      <Link>catalog\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\Localization\*.po">
      <Link>Localization\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\README.md">
      <Link>README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\docs\**\*.md">
      <Link>docs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts/**/*.cs" />
    <EmbeddedResource Remove="artifacts/**" />
    <None Remove="artifacts/**/*.cs" />
  </ItemGroup>

</Project>

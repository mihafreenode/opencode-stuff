<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenCode.Workspace.Avalonia.CheckpointWindow"
        Width="560"
        Height="280"
        MinWidth="520"
        MinHeight="240"
        Title="Create Checkpoint"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="20">
    <StackPanel Spacing="6">
      <TextBlock x:Name="TitleTextBlock" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="SummaryTextBlock" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="#D6D9DF" BorderThickness="1" CornerRadius="10" Padding="14">
      <StackPanel Spacing="10">
        <TextBlock Text="What happens" FontWeight="SemiBold" />
        <TextBlock x:Name="ConfirmationTextBlock" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="Checkpoint captures tracked changes and durable untracked files for local recovery." VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Cancel" Click="CancelClicked" />
      <Button Grid.Column="2" Classes="accent" Content="Create Checkpoint" Click="ConfirmClicked" />
    </Grid>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenCode.Workspace.Avalonia.ViewModels"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="OpenCode.Workspace.Avalonia.MainWindow"
        Title="opencode stuff"
        Width="1480"
        Height="920"
        MinWidth="1200"
        MinHeight="760"
        Icon="avares://OpenCode.Workspace.Avalonia/Assets/opencode-stuff-satchel-icon.ico"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:WorkspacesPageViewModel">
      <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Border Classes="panel">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
            <TextBlock Text="Workspaces" Classes="section-title" />
            <Button Grid.Column="1" Content="Create Workspace" Command="{Binding CreateWorkspaceCommand}" Classes="accent" />
            <Button Grid.Column="2" Content="Open Existing Repository" Command="{Binding OpenExistingRepositoryCommand}" />
            <Button Grid.Column="3" Command="{Binding RefreshWorkspacesCommand}" HorizontalAlignment="Right" MinWidth="88" Classes="toolbar-action">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                <TextBlock Text="Refresh" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                       Text="OpenCode organizes each workspace around what is ready to use first."
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="18">
          <Border Classes="panel">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
              <TextBlock Text="Local workspaces" Classes="section-title" />
              <StackPanel Grid.Row="1" Spacing="8" IsVisible="{Binding ShowLoadingState}">
                <TextBlock Text="{Binding LoadingTitle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LoadingMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding LoadingProgressLabel}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="8" IsVisible="{Binding ShowErrorState}">
                <TextBlock Text="Workspace discovery failed." TextWrapping="Wrap" />
                <TextBlock Text="{Binding LoadErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="8" IsVisible="{Binding ShowEmptyState}">
                <TextBlock Text="{Binding EmptyStateTitle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EmptyStateMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ListBox Grid.Row="3"
                        ItemsSource="{Binding Workspaces}"
                        SelectedItem="{Binding SelectedWorkspace}"
                        BorderThickness="0"
                        Background="Transparent"
                        IsVisible="{Binding HasWorkspaces}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="list-row"
                            Classes.workspace-list-card-selected="{Binding IsSelected}"
                            Margin="0,0,0,12"
                            automation:AutomationProperties.AutomationId="{Binding RowAutomationId}"
                            automation:AutomationProperties.Name="{Binding RowAutomationName}">
                      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="6" ColumnSpacing="10">
                        <Border Width="3"
                                Grid.RowSpan="5"
                                CornerRadius="999"
                                Background="{DynamicResource AccentBrush}"
                                IsVisible="{Binding IsSelected}" />
                        <TextBlock Text="{Binding Name}"
                                   Grid.Column="1"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   automation:AutomationProperties.AutomationId="{Binding TitleAutomationId}"
                                   automation:AutomationProperties.Name="{Binding TitleAutomationName}" />
                        <Border Grid.Column="2"
                                Classes="status-chip"
                                Classes.ready-chip="{Binding IsReadyStatus}"
                                Classes.warning-chip="{Binding IsWarningStatus}"
                                Classes.unavailable-chip="{Binding IsUnavailableStatus}">
                          <TextBlock Text="{Binding RuntimeStatusLabel}"
                                     Classes="status-chip-text"
                                     Classes.ready-chip="{Binding IsReadyStatus}"
                                     Classes.warning-chip="{Binding IsWarningStatus}"
                                     Classes.unavailable-chip="{Binding IsUnavailableStatus}"
                                     FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding WorkspaceTypeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RootPath}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" IsVisible="{Binding HasServiceDisplayItems}">
                          <TextBlock Text="Services" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                          <ItemsControl ItemsSource="{Binding ServiceDisplayItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                  <TextBlock Text="•" Foreground="{DynamicResource TextMutedBrush}" />
                                  <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <Button Grid.Row="4"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Classes="accent"
                                Content="{Binding PrimaryAction.Label}"
                                Command="{Binding PrimaryAction.Command}"
                                IsEnabled="{Binding PrimaryAction.IsEnabled}"
                                IsVisible="{Binding HasPrimaryAction}"
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="{Binding PrimaryAction.AutomationId}"
                                automation:AutomationProperties.Name="{Binding PrimaryAction.AutomationName}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedWorkspaceTabIndex}">
            <TabItem Header="Overview">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="0,8,0,0">
                  <Border Classes="panel-subtle" IsVisible="{Binding HasSelectedWorkspace}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="12">
                      <TextBlock Text="{Binding SelectedWorkspace.Name}" FontSize="30" FontWeight="SemiBold" />
                      <Border Grid.Column="1"
                              Classes="status-chip"
                              Classes.ready-chip="{Binding SelectedWorkspace.IsReadyStatus}"
                              Classes.warning-chip="{Binding SelectedWorkspace.IsWarningStatus}"
                              Classes.unavailable-chip="{Binding SelectedWorkspace.IsUnavailableStatus}"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding SelectedWorkspaceStateLabel}"
                                   Classes="status-chip-text"
                                   Classes.ready-chip="{Binding SelectedWorkspace.IsReadyStatus}"
                                   Classes.warning-chip="{Binding SelectedWorkspace.IsWarningStatus}"
                                   Classes.unavailable-chip="{Binding SelectedWorkspace.IsUnavailableStatus}"
                                   FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectedWorkspaceTypeLabel}" FontSize="17" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding DetailSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                      <Button Grid.Row="3"
                              Grid.ColumnSpan="2"
                              Classes="accent"
                              Content="{Binding DetailPrimaryAction.Label}"
                              Command="{Binding DetailPrimaryAction.Command}"
                              IsEnabled="{Binding DetailPrimaryAction.IsEnabled}"
                              IsVisible="{Binding ShowHeroPrimaryAction}"
                              HorizontalAlignment="Left"
                              automation:AutomationProperties.AutomationId="{Binding DetailPrimaryAction.AutomationId}"
                              automation:AutomationProperties.Name="{Binding DetailPrimaryAction.AutomationName}" />
                    </Grid>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding ShowMainAvailableServicesSection}" VerticalAlignment="Top" Margin="0,4,0,0">
                    <StackPanel Spacing="12" VerticalAlignment="Top">
                      <TextBlock Text="Start Working" Classes="section-title" />
                      <ItemsControl ItemsSource="{Binding CapabilityGroups}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="14" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="panel-subtle" VerticalAlignment="Top">
                              <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                  <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Services}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border Classes="list-row service-tile" VerticalAlignment="Top">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="8" VerticalAlignment="Top">
                                          <Border Width="40" Height="40" Classes="panel-subtle" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding ServiceGlyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="18" />
                                          </Border>
                                          <TextBlock Grid.Column="1" Text="{Binding Service}" FontSize="17" FontWeight="Bold" />
                                          <Border Grid.Column="2"
                                                  Classes="status-chip"
                                                  Classes.ready-chip="{Binding IsReadyStatus}"
                                                  Classes.warning-chip="{Binding IsWarningStatus}"
                                                  Classes.unavailable-chip="{Binding IsUnavailableStatus}"
                                                  IsVisible="{Binding HasStatus}">
                                            <TextBlock Text="{Binding Status}"
                                                       Classes="status-chip-text"
                                                       Classes.ready-chip="{Binding IsReadyStatus}"
                                                       Classes.warning-chip="{Binding IsWarningStatus}"
                                                       Classes.unavailable-chip="{Binding IsUnavailableStatus}"
                                                       FontWeight="SemiBold" />
                                          </Border>
                                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasDescription}" />
                                          <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <Button Content="Open" Classes="accent" Command="{Binding OpenServiceCommand}" IsEnabled="{Binding ActionsEnabled}" IsVisible="{Binding CanOpenService}" Margin="0,0,8,8" MinWidth="96" HorizontalAlignment="Left" HorizontalContentAlignment="Center" />
                                            <Button Content="Copy URL" Classes="quiet-action" Command="{Binding CopyUrlCommand}" IsEnabled="{Binding ActionsEnabled}" IsVisible="{Binding CanCopyUrl}" Margin="0,0,8,8" MinWidth="96" HorizontalAlignment="Left" HorizontalContentAlignment="Center" />
                                            <Button Content="Copy Credentials" Classes="quiet-action" Command="{Binding CopyCredentialsCommand}" IsEnabled="{Binding ActionsEnabled}" IsVisible="{Binding CanCopyCredentials}" Margin="0,0,8,8" MinWidth="132" HorizontalAlignment="Left" HorizontalContentAlignment="Center" />
                                            <Button Content="Copy Command" Classes="quiet-action" Command="{Binding CopyCommandCommand}" IsEnabled="{Binding ActionsEnabled}" IsVisible="{Binding CanCopyCommand}" Margin="0,0,8,8" MinWidth="124" HorizontalAlignment="Left" HorizontalContentAlignment="Center" />
                                            <Button Content="Documentation" Classes="quiet-action" Command="{Binding OpenDocsCommand}" IsEnabled="{Binding ActionsEnabled}" IsVisible="{Binding CanOpenDocs}" Margin="0,0,8,8" MinWidth="120" HorizontalAlignment="Left" HorizontalContentAlignment="Center" />
                                          </WrapPanel>
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding ShowMainRecentActivitySection}">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Recent Activity" Classes="section-title" />
                      <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,8">
                              <Border Width="8" Height="8" CornerRadius="999" Background="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                              <StackPanel Grid.Column="1" Spacing="2">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                  <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasSummary}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding ShowMainQuickActionsSection}">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Quick Actions" Classes="section-title" />
                      <ItemsControl ItemsSource="{Binding DetailVisibleActions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemHeight="40" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding Command}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Margin="0,0,8,8"
                                    automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                    automation:AutomationProperties.Name="{Binding AutomationName}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Progress">
              <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,8,0,0">
                <Border Classes="panel-subtle">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Current Operation" Classes="section-title" />
                    <TextBlock Text="{Binding WorkspaceProgressTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding WorkspaceProgressCurrentStep}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Classes="panel-subtle">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Recent Progress" Classes="section-title" />
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,8">
                            <Border Width="8" Height="8" CornerRadius="999" Background="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="{DynamicResource TextMutedBrush}" />
                              </Grid>
                              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasSummary}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>
            </TabItem>

            <TabItem Header="Operation Log">
              <Border Classes="panel-subtle" Margin="0,8,0,0" IsVisible="{Binding ShowOperationLogPanel}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Text="Operation Log" Classes="section-title" />
                    <CheckBox Grid.Column="1" Content="Follow latest output" IsChecked="{Binding FollowLatestOutput}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Copy all" Command="{Binding CopyOperationLogCommand}" />
                    <Button Grid.Column="3" Content="Clear view" Command="{Binding ClearOperationLogCommand}" />
                  </Grid>
                  <DockPanel Grid.Row="1" LastChildFill="True">
                    <TextBlock Text="Full live workspace output. The log viewer owns its own scrolling." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBox Grid.Row="2"
                           Text="{Binding OperationLogText}"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           VerticalAlignment="Stretch"
                           TextChanged="WorkspaceOperationLogTextChanged" />
                </Grid>
              </Border>
            </TabItem>

            <TabItem Header="APEXlang Assistant" IsVisible="{Binding SupportsApexAssistant}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,8,0,0">
                  <Border Classes="panel-subtle">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Plan APEXlang Change" Classes="section-title" />
                      <TextBlock Text="Prompt → semantic plan → review → semantic edit → SQLcl validation → repair → revalidate → import → preview." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding ApexAssistantPrompt}" Watermark="Describe the Oracle APEX change you want to make" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" />
                      <TextBlock Text="{Binding ApexAssistantStageLabel}" FontWeight="SemiBold" IsVisible="{Binding HasApexAssistantReview}" />
                      <CheckBox Content="Allow safe semantic auto-repair for this request" IsChecked="{Binding ApexAssistantAllowSafeAutomaticRepair}" IsVisible="{Binding ApexAssistantSafeAutomaticRepairConfigured}" />
                      <TextBlock Text="Safe automatic repair is active for this request." Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding ApexAssistantSafeAutomaticRepairActive}" />
                      <CheckBox Content="Allow deployment to a non-development environment for this request" IsChecked="{Binding ApexAssistantAllowNonDevelopmentImport}" />
                      <WrapPanel>
                        <Button Content="Plan APEXlang Change" Classes="accent" Command="{Binding PlanApexlangChangeCommand}" Margin="0,0,8,8" />
                        <Button Content="Review Plan" Command="{Binding ReviewApexlangPlanCommand}" Margin="0,0,8,8" />
                        <Button Content="Build Repair Plan" Command="{Binding BuildApexlangRepairPlanCommand}" Margin="0,0,8,8" />
                        <Button Content="Apply Repair" Command="{Binding ApplyApexlangRepairCommand}" Margin="0,0,8,8" />
                        <Button Content="Revalidate" Command="{Binding RevalidateApexlangCommand}" Margin="0,0,8,8" />
                        <Button Content="Import" Command="{Binding ImportApexlangCommand}" Margin="0,0,8,8" />
                        <Button Content="Open Diagnostic Source" Command="{Binding OpenApexDiagnosticSourceCommand}" Margin="0,0,8,8" />
                        <Button Content="Roll Back Generated Change" Command="{Binding RollBackApexlangGeneratedChangeCommand}" Margin="0,0,8,8" />
                        <Button Content="Cancel Plan" Command="{Binding CancelApexlangPlanCommand}" Margin="0,0,8,8" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding HasApexAssistantReview}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Review Plan" Classes="section-title" />
                      <TextBlock Text="{Binding ApexAssistantClassificationLabel}" FontWeight="SemiBold" />
                      <CheckBox Content="I approve this risky plan" IsChecked="{Binding ApexAssistantApprovalConfirmed}" IsVisible="{Binding ApexAssistantConfirmationRequired}" />
                      <TextBlock Text="{Binding ApexAssistantExecutionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Text="{Binding ApexAssistantReviewText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" />
                      <WrapPanel>
                        <Button Content="Apply Source Only" Command="{Binding ApplyApexlangSourceOnlyCommand}" Margin="0,0,8,8" />
                        <Button Content="Apply and Validate" Command="{Binding ApplyApexlangValidateOnlyCommand}" Margin="0,0,8,8" />
                        <Button Content="Apply, Validate and Import" Classes="accent" Command="{Binding ApplyApexlangValidateAndImportCommand}" Margin="0,0,8,8" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding HasApexAssistantChangedFiles}">
                    <StackPanel Spacing="8">
                      <WrapPanel>
                        <TextBlock Text="Changed Files" Classes="section-title" Margin="0,0,12,0" />
                        <Button Content="Show Changed Files" Command="{Binding ShowApexlangChangedFilesCommand}" Margin="0,0,8,8" />
                      </WrapPanel>
                      <TextBox Text="{Binding ApexAssistantChangedFilesText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding HasApexAssistantDiagnostics}">
                    <StackPanel Spacing="8">
                      <WrapPanel>
                        <TextBlock Text="Semantic Diagnostics And Warnings" Classes="section-title" Margin="0,0,12,0" />
                        <Button Content="Show Diagnostics" Command="{Binding ShowApexlangDiagnosticsCommand}" Margin="0,0,8,8" />
                      </WrapPanel>
                      <TextBox Text="{Binding ApexAssistantDiagnosticsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding HasApexAssistantCompilerDiagnostics}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Compiler Diagnostics" Classes="section-title" />
                      <TextBox Text="{Binding ApexAssistantCompilerDiagnosticsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding HasApexAssistantRepairReview}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Repair Review" Classes="section-title" />
                      <TextBox Text="{Binding ApexAssistantRepairReviewText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding HasApexAssistantEvidence}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Evidence" Classes="section-title" />
                      <TextBox Text="{Binding ApexAssistantEvidenceText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding CanOpenApexPreviewActions}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Preview" Classes="section-title" />
                      <WrapPanel>
                        <Button Content="Open Application" Command="{Binding OpenApexApplicationCommand}" Margin="0,0,8,8" />
                        <Button Content="Open Builder" Command="{Binding OpenApexBuilderCommand}" Margin="0,0,8,8" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,8,0,0">
                  <Border Classes="panel-subtle" IsVisible="{Binding HasDetailAdvancedActions}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Manual Recovery" Classes="section-title" />
                      <ItemsControl ItemsSource="{Binding DetailAdvancedActions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="panel-subtle" Margin="0,0,0,8">
                              <StackPanel Spacing="6">
                                <Button Content="{Binding Label}"
                                        Command="{Binding Command}"
                                        IsEnabled="{Binding IsEnabled}"
                                        HorizontalAlignment="Left"
                                        automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                        automation:AutomationProperties.Name="{Binding AutomationName}" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasDescription}" />
                                <TextBlock Text="{Binding DisabledReason}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding ShowDisabledReason}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding HasDetailServices}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Diagnostics" Classes="section-title" />
                      <ItemsControl ItemsSource="{Binding DetailServices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="panel-subtle" Margin="0,0,0,8">
                              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                <Expander Grid.Row="3" Grid.ColumnSpan="2" Header="Technical details" IsVisible="{Binding HasDetails}">
                                  <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
                                </Expander>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="panel-subtle" IsVisible="{Binding HasDetailItems}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Technical Evidence" Classes="section-title" />
                      <ItemsControl ItemsSource="{Binding DetailItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="panel-subtle" Margin="0,0,0,8">
                              <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:RuntimeResourcesPageViewModel">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Runtime Resource Explorer" Classes="section-title" />
            <TextBlock Text="Workspace-owned runtime resources, conflicts, orphaned resources, and service links." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="panel">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="accent" Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Content="Clean Orphaned Resources" Command="{Binding CleanOrphanedResourcesCommand}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
          <StackPanel Spacing="12">
            <TextBlock Text="Workspaces" Classes="section-title" />
            <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <DockPanel>
                        <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Border DockPanel.Dock="Right" Classes="status-chip">
                          <TextBlock Text="{Binding Status}" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding Health}" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{Binding WorkspaceRootPath}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Resources" Classes="section-title" />
            <ListBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <DockPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Border DockPanel.Dock="Right" Classes="status-chip">
                          <TextBlock Text="{Binding Status}" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding WorkspaceName}" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{Binding ResourceType}" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Conflicts" Classes="section-title" />
            <ListBox ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <DockPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Border DockPanel.Dock="Right" Classes="status-chip">
                          <TextBlock Text="{Binding ConflictType}" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding CurrentOwner}" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{Binding RecommendedAction}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Unused" Classes="section-title" />
            <ListBox ItemsSource="{Binding UnusedResources}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding CleanupSummary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Orphaned" Classes="section-title" />
            <ListBox ItemsSource="{Binding OrphanedResources}" SelectedItem="{Binding SelectedOrphanedResource}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <DockPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Border DockPanel.Dock="Right" Classes="status-chip">
                          <TextBlock Text="{Binding Health}" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding ResourceType}" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{Binding CleanupSummary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Health" Classes="section-title" />
            <ListBox ItemsSource="{Binding HealthItems}" SelectedItem="{Binding SelectedHealth}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <DockPanel>
                        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Border DockPanel.Dock="Right" Classes="status-chip">
                          <TextBlock Text="{Binding Status}" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:DiagnosticsPageViewModel">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Diagnostics" Classes="section-title" />
            <TextBlock Text="Readable host and workspace checks powered by shared core services."
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="panel">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox Width="340" ItemsSource="{Binding WorkspaceTargets}" SelectedItem="{Binding SelectedWorkspaceTarget}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="accent" Content="Run Doctor" Command="{Binding RunDoctorCommand}" />
            <Button Content="Validate linux/amd64" Command="{Binding ValidateAmd64Command}" />
            <Button Content="Validate linux/arm64" Command="{Binding ValidateArm64Command}" />
          </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

        <Border Grid.Row="3" Classes="panel-subtle">
          <StackPanel Spacing="6">
            <TextBlock Text="Latest validation context" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LatestValidationContext}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding HasValidationResults}" />
            <TextBlock Text="{Binding LatestDoctorSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding HasDoctorResults}" />
            <TextBlock Text="{Binding LatestWorkspaceLoadSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="4">
          <StackPanel Spacing="12">
            <TextBlock Text="Required Prerequisites" Classes="section-title" />
            <ItemsControl ItemsSource="{Binding RequiredDoctorItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"
                                   automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                   automation:AutomationProperties.Name="{Binding AutomationName}" />
                        <Border DockPanel.Dock="Right" Classes="status-chip">
                          <TextBlock Text="{Binding StatusLabel}" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SuggestedAction}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding HasSuggestedAction}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Doctor" Classes="section-title" />
            <ListBox ItemsSource="{Binding DoctorItems}" SelectedItem="{Binding SelectedDoctorItem}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8"
                          automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                          automation:AutomationProperties.Name="{Binding AutomationName}">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"
                                   automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                   automation:AutomationProperties.Name="{Binding AutomationName}" />
                        <Border DockPanel.Dock="Right" Classes="status-chip">
                          <TextBlock Text="{Binding StatusLabel}" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SuggestedAction}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding HasSuggestedAction}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Platform Validation" Classes="section-title" />
            <TextBlock Text="{Binding LatestValidationSummary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding ValidationItems}" SelectedItem="{Binding SelectedValidationItem}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Border DockPanel.Dock="Right" Classes="status-chip">
                          <TextBlock Text="{Binding StatusLabel}" />
                        </Border>
                      </DockPanel>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SuggestedAction}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding HasSuggestedAction}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:WorkspaceTroubleshootingPageViewModel">
      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Workspace Troubleshooting" Classes="section-title" />
            <TextBlock Text="OpenCode explains what is happening, what it already tried, and what the next best step is for this workspace."
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
          <Border Classes="panel-subtle">
            <StackPanel Spacing="8">
              <TextBlock Text="What is happening?" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DetailSummary}" TextWrapping="Wrap" />
              <TextBlock Text="Status" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding CurrentDiagnosis}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="panel-subtle">
            <StackPanel Spacing="8">
              <TextBlock Text="Current diagnosis" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CurrentDiagnosis}" TextWrapping="Wrap" />
              <TextBlock Text="Confidence" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding CurrentConfidence}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="12">
          <StackPanel Spacing="10">
            <Border Classes="panel-subtle">
              <StackPanel Spacing="8">
                <TextBlock Text="What should we try next?" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RecommendedNextStep}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RecommendedNextStepDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding RecommendedNextStepDuration}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasDetailRecommendation}" />
                <Button Classes="accent"
                        Content="{Binding DetailPrimaryAction.Label}"
                        Command="{Binding DetailPrimaryAction.Command}"
                        IsEnabled="{Binding DetailPrimaryAction.IsEnabled}"
                        IsVisible="{Binding ShowDetailPrimaryAction}"
                        automation:AutomationProperties.AutomationId="{Binding DetailPrimaryAction.AutomationId}"
                        automation:AutomationProperties.Name="{Binding DetailPrimaryAction.AutomationName}" />
              </StackPanel>
            </Border>

            <Border Classes="panel-subtle" IsVisible="{Binding HasInvestigationActions}">
              <StackPanel Spacing="8">
                <TextBlock Text="Investigation actions" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding InvestigationActions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="panel-subtle" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                          <Button Content="{Binding Label}"
                                  Command="{Binding Command}"
                                  IsEnabled="{Binding IsEnabled}"
                                  automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                  automation:AutomationProperties.Name="{Binding AutomationName}" />
                          <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="10">
            <Border Classes="panel-subtle">
              <StackPanel Spacing="8">
                <TextBlock Text="Visible actions" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding DetailVisibleActions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="panel-subtle" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                          <Button Content="{Binding Label}"
                                  Command="{Binding Command}"
                                  IsEnabled="{Binding IsEnabled}"
                                  automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                  automation:AutomationProperties.Name="{Binding AutomationName}" />
                          <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Expander Header="Advanced" IsExpanded="{Binding ShowAdvancedActions}" IsVisible="{Binding HasDetailAdvancedActions}">
              <ItemsControl ItemsSource="{Binding DetailAdvancedActions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="panel-subtle" Margin="0,8,0,0">
                      <StackPanel Spacing="6">
                        <Button Content="{Binding Label}"
                                Command="{Binding Command}"
                                IsEnabled="{Binding IsEnabled}"
                                automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                automation:AutomationProperties.Name="{Binding AutomationName}" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="3">
          <StackPanel Spacing="12">
            <TextBlock Text="Why do we think this happened?" Classes="section-title" />
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding CurrentEvidence}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
            </Border>

            <TextBlock Text="Evidence" Classes="section-title" />
            <ItemsControl ItemsSource="{Binding DetailItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="8" IsVisible="{Binding HasDetailServices}">
              <TextBlock Text="Applications" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding DetailServices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="panel-subtle" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2" IsVisible="{Binding HasApplications}">
                          <TextBlock Text="Applications" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Applications}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding PrimaryUrl}" TextWrapping="Wrap" IsVisible="{Binding HasPrimaryUrl}" />
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Highlights}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasHighlights}" />
                        <Expander Grid.Row="6" Grid.ColumnSpan="2" Header="Details" IsVisible="{Binding HasDetails}">
                          <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
                        </Expander>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasRepairHistory}">
              <TextBlock Text="What have we already tried?" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding RepairHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="panel-subtle" Margin="0,0,0,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Outcome}" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasEvidence}" />
                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasRecommendation}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasInvestigationHistory}">
              <TextBlock Text="Investigation timeline" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding InvestigationHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="panel-subtle" Margin="0,0,0,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Outcome}" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasEvidence}" />
                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasRecommendation}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasTranscriptExcerpt}">
              <TextBlock Text="Transcript Excerpt" Classes="section-title" />
              <TextBox Text="{Binding TranscriptExcerpt}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       MinHeight="180" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasSuggestedNextSteps}">
              <TextBlock Text="Next Steps" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding SuggestedNextSteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding .}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:TemplatesPageViewModel">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Templates" Classes="section-title" />
            <TextBlock Text="Built-in starting points from the repository catalog." Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="list-row" Margin="0,0,0,10">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Features}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="mini-chip" Margin="0,0,6,6">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="mini-chip" Margin="0,0,6,6">
                          <TextBlock Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:SavePointsPageViewModel">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Timeline" Classes="section-title" />
            <TextBlock Text="Workspace Save Points and related history entries with safe copy and open actions." Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="1">
          <Border Classes="panel-subtle" IsVisible="{Binding IsLoading}">
            <TextBlock Text="Loading timeline..." Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
          <Border Classes="panel-subtle" IsVisible="{Binding ShowErrorState}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </Border>
          <Border Classes="panel-subtle" IsVisible="{Binding ShowEmptyState}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
          <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0" Background="Transparent" IsVisible="{Binding ShowList}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="list-row" Margin="0,0,0,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding TimestampLabel}" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:TranscriptsPageViewModel">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Transcripts" Classes="section-title" />
            <TextBlock Text="Structured activity history from workspace timelines." Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="list-row" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                  <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding TimestampLabel}" Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock Grid.Row="1" Text="{Binding Workspace}" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Result}" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:RemoteTargetsPageViewModel">
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Remote Targets" Classes="section-title" />
          <TextBlock Text="Remote targets are planned for portable SSH-backed workspaces. This preview shell focuses on local workspace inspection first."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:DocumentationPageViewModel">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Documentation" Classes="section-title" />
            <TextBlock Text="Local repository docs opened with the host default handler." Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="list-row" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <Button Grid.Column="1" Classes="accent" Content="Open" Command="{Binding OpenCommand}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:SettingsPageViewModel">
      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Settings" Classes="section-title" />
            <TextBlock Text="Cross-platform preview shell settings and app information." Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="panel">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox Width="180" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedThemeMode}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Windows Terminal" Classes="section-title" />
            <TextBlock Text="Create or update the managed OpenCode Stuff Windows Terminal profile for the currently selected workspace." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            <Button Content="Configure Windows Terminal profile" Command="{Binding SetupWindowsTerminalProfileCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding TerminalProfileStatus}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="3" Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="App info" Classes="section-title" />
            <TextBlock Text="{Binding AppVersionLine}" />
            <TextBlock Text="{Binding AppBuildLine}" />
            <TextBlock Text="{Binding GeneratorLine}" />
            <TextBlock Text="{Binding RuntimeStateExplanation}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="220,*,340">
    <Border Grid.ColumnSpan="3"
            Background="{DynamicResource ShellHeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource HeaderPadding}"
            MinHeight="{DynamicResource HeaderHeight}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource HeaderColumnSpacing}" VerticalAlignment="Center">
        <Image Source="avares://OpenCode.Workspace.Avalonia/Assets/opencode-stuff-header-brand-ui.png"
                 Height="{DynamicResource HeaderLogoHeight}"
                 MaxWidth="760"
                 Stretch="Uniform"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
        <Border Grid.Column="1" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource HeaderStatSpacing}" VerticalAlignment="Center">
          <Border Classes="header-stat">
            <StackPanel Spacing="{DynamicResource HeaderStatTextSpacing}">
              <TextBlock Text="Workspaces" FontSize="{DynamicResource HeaderStatLabelFontSize}" Foreground="{DynamicResource BrandHeaderMutedBrush}" />
              <TextBlock Text="{Binding HeaderWorkspaceCount}" FontSize="{DynamicResource HeaderWorkspaceCountFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="header-stat">
            <StackPanel Spacing="{DynamicResource HeaderStatTextSpacing}">
              <TextBlock Text="Runtime" FontSize="{DynamicResource HeaderStatLabelFontSize}" Foreground="{DynamicResource BrandHeaderMutedBrush}" />
              <TextBlock Text="{Binding HeaderRuntimeSummary}" FontSize="{DynamicResource HeaderStatValueFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource BrandHeaderTextBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="header-stat">
            <StackPanel Spacing="{DynamicResource HeaderStatTextSpacing}">
              <TextBlock Text="Status" FontSize="{DynamicResource HeaderStatLabelFontSize}" Foreground="{DynamicResource BrandHeaderMutedBrush}" />
              <TextBlock Text="{Binding HeaderStatusSummary}" FontSize="{DynamicResource HeaderStatValueFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="16" Classes="panel">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding NavigationItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="10">
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="999" IsVisible="{Binding IsSelected}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding IconGlyph}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           FontSize="16" />
                <Button Grid.Column="2"
                        Classes="nav-item"
                        Classes.nav-item-selected="{Binding IsSelected}"
                        Content="{Binding Title}"
                        Command="{Binding SelectCommand}"
                        MinWidth="150" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Margin="0,16,16,16" Classes="panel-root" IsVisible="{Binding IsStandardPageSelected}">
      <ContentControl Content="{Binding CurrentPage}" />
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,16,16,16" Classes="panel-root" IsVisible="{Binding IsWorkspacePageSelected}">
      <ContentControl Content="{Binding CurrentPage}" />
    </Border>

    <Border Grid.Row="1" Grid.Column="2" Margin="0,16,16,16" Classes="panel" IsVisible="{Binding IsStandardPageSelected}">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <TextBlock Text="{Binding CurrentPage.DetailTitle}" Classes="section-title" />
        <Border Grid.Row="1" Classes="panel-subtle" MinHeight="74" MaxHeight="96">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding CurrentPage.DetailSummary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding CurrentPage.DetailRecommendation}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding CurrentPage.HasDetailRecommendation}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Classes="panel-subtle" IsVisible="{Binding CurrentPage.ShowDetailPrimaryAction}">
          <StackPanel Spacing="6">
            <TextBlock Text="Recommended action" FontWeight="SemiBold" />
            <Button Classes="accent"
                    Content="{Binding CurrentPage.DetailPrimaryAction.Label}"
                    Command="{Binding CurrentPage.DetailPrimaryAction.Command}"
                    IsEnabled="{Binding CurrentPage.DetailPrimaryAction.IsEnabled}"
                    automation:AutomationProperties.AutomationId="{Binding CurrentPage.DetailPrimaryAction.AutomationId}"
                    automation:AutomationProperties.Name="{Binding CurrentPage.DetailPrimaryAction.AutomationName}" />
            <TextBlock Text="{Binding CurrentPage.DetailPrimaryAction.Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding CurrentPage.DetailPrimaryAction.HasDescription}" />
            <TextBlock Text="{Binding CurrentPage.DetailPrimaryAction.DisabledReason}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding CurrentPage.DetailPrimaryAction.ShowDisabledReason}" />
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <ItemsControl ItemsSource="{Binding CurrentPage.DetailItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10" Spacing="3">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="8" IsVisible="{Binding CurrentPage.HasDetailAvailableServices}">
              <TextBlock Text="Available Services" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding CurrentPage.DetailAvailableServices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="panel-subtle" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="2.1*,2.1*,1.4*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding Service}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
                          <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding OpenOrCommand}" TextWrapping="Wrap" />
                          <WrapPanel ItemHeight="28" ItemWidth="112">
                            <Button Content="Open Service" Command="{Binding OpenServiceCommand}" IsVisible="{Binding CanOpenService}" />
                            <Button Content="Copy URL" Command="{Binding CopyUrlCommand}" IsVisible="{Binding CanCopyUrl}" />
                            <Button Content="Copy Command" Command="{Binding CopyCommandCommand}" IsVisible="{Binding CanCopyCommand}" />
                            <Button Content="Open Docs" Command="{Binding OpenDocsCommand}" IsVisible="{Binding CanOpenDocs}" />
                          </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                          <TextBlock Text="{Binding Credentials}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding HasCredentials}" />
                          <Button Content="Copy Credentials" Command="{Binding CopyCredentialsCommand}" IsVisible="{Binding CanCopyCredentials}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding CurrentPage.HasDetailServices}">
              <TextBlock Text="Service Health" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding CurrentPage.DetailServices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="panel-subtle" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2" IsVisible="{Binding HasApplications}">
                          <TextBlock Text="Applications" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Applications}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding PrimaryUrl}" TextWrapping="Wrap" IsVisible="{Binding HasPrimaryUrl}" />
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Highlights}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasHighlights}" />
                        <Expander Grid.Row="6" Grid.ColumnSpan="2" Header="Details" IsVisible="{Binding HasDetails}">
                          <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
                        </Expander>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="320">
          <StackPanel Spacing="10">
            <ItemsControl ItemsSource="{Binding CurrentPage.DetailVisibleActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="panel-subtle" Margin="0,0,0,8" MinHeight="86">
                    <StackPanel Spacing="6">
                      <Button Content="{Binding Label}"
                              Command="{Binding Command}"
                              IsEnabled="{Binding IsEnabled}"
                              automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                              automation:AutomationProperties.Name="{Binding AutomationName}" />
                      <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}" />
                      <TextBlock Text="{Binding DisabledReason}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowDisabledReason}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="Advanced" IsExpanded="{Binding CurrentPage.ShowAdvancedActions}" IsVisible="{Binding CurrentPage.HasDetailAdvancedActions}">
              <ItemsControl ItemsSource="{Binding CurrentPage.DetailAdvancedActions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="panel-subtle" Margin="0,8,0,0" MinHeight="86">
                      <StackPanel Spacing="6">
                        <Button Content="{Binding Label}"
                                Command="{Binding Command}"
                                IsEnabled="{Binding IsEnabled}"
                                automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                automation:AutomationProperties.Name="{Binding AutomationName}" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}" />
                        <TextBlock Text="{Binding DisabledReason}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowDisabledReason}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource ShellFooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18">
        <TextBlock Text="{Binding StatusBarState}" />
        <TextBlock Grid.Column="1" Text="{Binding StatusBarWorkspace}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Grid.Column="2" Text="{Binding StatusBarBranch}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Grid.Column="3" Text="{Binding StatusBarRuntime}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Grid.Column="4" Text="{Binding StatusBarProtection}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Grid.Column="5" Text="{Binding StatusBarBuild}" Foreground="{DynamicResource TextMutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>

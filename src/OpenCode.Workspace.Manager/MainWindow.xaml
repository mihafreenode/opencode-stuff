<Window x:Class="OpenCode.Workspace.Manager.MainWindow"
         x:Name="MainWindowRoot"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:OpenCode.Workspace.Manager.Controls"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:models="clr-namespace:OpenCode.Workspace.Core.Models;assembly=OpenCode.Workspace.Core"
         mc:Ignorable="d"
         Title="{Binding Title}" Height="880" Width="1400" MinWidth="1200" MinHeight="760" Icon="Assets/Icons/opencode-stuff-app.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="20" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding DashboardTitle}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding DashboardSubtitle}" Foreground="{StaticResource BrandTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Menu DockPanel.Dock="Right" Background="Transparent" BorderThickness="0">
                    <MenuItem Header="Help">
                        <MenuItem Header="Quick Tutorial" Click="OpenQuickTutorial_OnClick" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowWorkspaceSidePanels, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Border Padding="16" Margin="0,20,0,0" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding CreateWorkspaceDialogTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding CreateWorkspaceDialogDescription}" Foreground="{StaticResource BrandTextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Margin="0,16,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,8"
                                Content="{Binding CreateLabel}"
                                Click="OpenCreateWorkspaceDialog_OnClick"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanStartCreateWorkspaceFlow}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding CreateWorkspaceDisabledReason}" />
                    </StackPanel>
                </Border>

                <Border Padding="16" Margin="0,20,0,0" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding HealthTitle}" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <Button Padding="12,6" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" />
                        </DockPanel>

                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Diagnostics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DiagnosticResult}">
                                    <Border Margin="0,0,0,10" Padding="12" Background="{StaticResource BrandSurfaceSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Message}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding TechnicalDetails}" Foreground="{StaticResource BrandTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Padding="16" Margin="0,20,0,0" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="App Diagnostics" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Margin="0,12,0,0" Text="Executable Path" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppExecutablePath}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Configuration" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppBuildConfiguration}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Version" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppAssemblyVersion}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Informational Version" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppInformationalVersion}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Git Commit SHA" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppGitCommitSha}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Build Timestamp" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppBuildTimestamp}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Workspace Generator Version" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WorkspaceGeneratorVersion}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Generated Template/Schema Version" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GeneratedSchemaVersion}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16" Margin="0,20,0,0" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="{Binding WorkspacesTitle}" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left" />
                    <Button Padding="12,6" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Border Padding="48"
                        Background="{StaticResource BrandSurfaceBrush}"
                        CornerRadius="12"
                        BorderThickness="1"
                        Visibility="{Binding ShowWorkspaceLoadingState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid MinWidth="420">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="640">
                            <TextBlock Text="{Binding WorkspaceLoadingTitle}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding WorkspaceLoadingDescription}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource BrandTextSecondaryBrush}" />
                            <ProgressBar Margin="0,24,0,0"
                                         Height="8"
                                         Width="280"
                                         HorizontalAlignment="Center"
                                         IsIndeterminate="True" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Visibility="{Binding ShowWorkspaceSidePanels, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Grid.ColumnSpan="3" Padding="14,10" Margin="0,0,0,12" Background="#FFF7E8" BorderBrush="#FFD28A" BorderThickness="1" CornerRadius="10"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowWorkspaceReloadErrorBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding WorkspaceReloadErrorBannerText}" TextWrapping="Wrap" Foreground="#8A4B00" Width="760" />
                            <Button DockPanel.Dock="Right"
                                    Margin="16,0,0,0"
                                    Padding="12,6"
                                    Content="{Binding RefreshLabel}"
                                    Command="{Binding RefreshCommand}" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="0" Padding="12" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1"
                            Visibility="{Binding ShowWorkspaceListState, Converter={StaticResource BooleanToVisibilityConverter}}">
                     <ListBox x:Name="WorkspaceListBox"
                              ItemsSource="{Binding Workspaces}"
                              SelectedItem="{Binding SelectedWorkspace}"
                             BorderThickness="0"
                             MouseDoubleClick="WorkspaceListBox_OnMouseDoubleClick"
                             KeyDown="WorkspaceListBox_OnKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="WorkspaceListItem_OnPreviewMouseRightButtonDown" />
                                <EventSetter Event="ContextMenuOpening" Handler="WorkspaceListItem_OnContextMenuOpening" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="WorkspaceCard" Margin="0,0,0,12" Padding="14" Background="{StaticResource BrandSurfaceSubtleBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                            <controls:WorkspaceStatusIndicator DockPanel.Dock="Right" />
                                        </DockPanel>

                                        <TextBlock Margin="0,8,0,0" Text="{Binding ShortRootPath}" TextWrapping="Wrap" Foreground="{StaticResource BrandTextMutedBrush}" />

                                        <TextBlock Margin="0,10,0,0" Text="{Binding LastOperationSummary}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding ServicesStatusSummary}" TextWrapping="Wrap" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Border>

                    <Border Grid.Column="0" Grid.ColumnSpan="3" Padding="48" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1"
                            Visibility="{Binding ShowWorkspaceErrorState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock Text="{Binding WorkspaceLoadFailedTitle}" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Margin="0,12,0,0" Text="{Binding WorkspaceLoadFailedDescription}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                            <Button Margin="0,24,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="18,10"
                                    Content="{Binding RefreshLabel}"
                                    Command="{Binding RefreshCommand}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="0" Grid.ColumnSpan="3" Padding="48" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1"
                            Visibility="{Binding ShowOnboardingState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock Text="{Binding OnboardingTitle}" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Margin="0,12,0,0" Text="{Binding OnboardingDescription}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                            <Button Margin="0,24,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="18,10"
                                    Content="{Binding OnboardingActionLabel}"
                                    Click="OpenCreateWorkspaceDialog_OnClick"
                                    HorizontalAlignment="Center"
                                    IsEnabled="{Binding CanStartCreateWorkspaceFlow}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding CreateWorkspaceDisabledReason}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="16" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1"
                            Visibility="{Binding ShowWorkspaceDetailsPane, Converter={StaticResource BooleanToVisibilityConverter}}">
                     <Grid>
                         <StackPanel Visibility="{Binding ShowWorkspaceDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding SelectedWorkspaceTitle}" FontSize="20" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" Content="{Binding SelectedPrimaryActionLabel}" Command="{Binding PrimaryWorkspaceActionCommand}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding StartWorkspaceLabel}" Command="{Binding StartWorkspaceCommand}"
                                        Visibility="{Binding ShowStartWorkspaceAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding RecoverWorkspaceLabel}" Command="{Binding RecoverWorkspaceCommand}"
                                        Visibility="{Binding ShowRecoverWorkspaceAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="View Error" Command="{Binding ViewWorkspaceErrorCommand}"
                                        Visibility="{Binding ShowViewWorkspaceErrorAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding ShutDownLabel}" Command="{Binding ShutDownWorkspaceCommand}" IsEnabled="{Binding CanShutDownSelectedWorkspace}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding CreateSavePointLabel}" Command="{Binding CreateSavePointCommand}" ToolTip="{Binding CreateSavePointHelpText}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding CreateCheckpointLabel}" Command="{Binding CreateCheckpointCommand}" ToolTip="{Binding CreateCheckpointHelpText}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding PublishLabel}" Command="{Binding PublishWorkspaceCommand}" ToolTip="{Binding PublishHelpText}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Padding="14,8" Content="{Binding OpenFolderLabel}" Command="{Binding OpenFolderCommand}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding CopyPathLabel}" Command="{Binding CopyWorkspacePathCommand}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding OpenAdvancedGitViewLabel}" Command="{Binding OpenAdvancedGitViewCommand}" />
                                <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding RemoveLabel}" Command="{Binding RemoveWorkspaceCommand}" />
                            </WrapPanel>

                            <TextBlock Margin="0,16,0,4" Text="{Binding SelectedStatusLabel}" FontWeight="SemiBold" />
                            <controls:WorkspaceStatusIndicator DataContext="{Binding SelectedWorkspace}" />

                            <TextBlock Margin="0,12,0,4" Text="{Binding SelectedLastOperationLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceLastOperation}" TextWrapping="Wrap" />

                            <TextBlock Margin="0,16,0,4" Text="{Binding SelectedNameLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceName}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="{Binding SelectedPathLabel}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SelectedWorkspacePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" />
                            <TextBlock Margin="0,12,0,4" Text="Repository Path" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedRepositoryPath}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="Current Branch" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceCurrentBranch}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="Default Branch" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceDefaultBranch}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="Remote Origin" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceRemoteOrigin}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="Dirty Working Tree" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceDirtyStatus}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="Branch Status" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceBranchModeStatus}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="Session" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceSessionStatus}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="{Binding SelectedImageLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceImage}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="Node Runtime" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceNodeVersion}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="{Binding SelectedFeaturesLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceFeatures}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="{Binding SelectedServicesLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceServices}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,4" Text="{Binding SelectedServicesStatusLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceServicesStatus}" TextWrapping="Wrap" />

                            <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource BrandSurfaceSubtleBrush}" CornerRadius="8"
                                    Visibility="{Binding SelectedWorkspaceHasOracleDemo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Oracle Demo Database" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0" Text="Status" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedOracleDemoStatus}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="Startup Progress" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OracleStartupStage}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="Host" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OracleDemoHost}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="Port" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OracleDemoPort}" TextWrapping="Wrap" />
                                     <TextBlock Margin="0,8,0,0" Text="Service" FontWeight="SemiBold" />
                                     <TextBlock Text="{Binding OracleDemoServiceName}" TextWrapping="Wrap" />
                                     <TextBlock Margin="0,10,0,0" Foreground="{StaticResource BrandTextSecondaryBrush}" Text="{Binding OracleDemoProvisioningNote}" TextWrapping="Wrap" />
                                     <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrandTextSecondaryBrush}" Text="{Binding OracleOpenCodeGuidance}" TextWrapping="Wrap" />
                                     <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" Content="Start" Command="{Binding StartOracleDemoCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="Stop" Command="{Binding ShutDownWorkspaceCommand}" IsEnabled="{Binding CanShutDownSelectedWorkspace}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="Reset" Command="{Binding ResetOracleDemoCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="View Logs" Command="{Binding ViewOracleLogsCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="Copy Connection Details" Command="{Binding CopyOracleConnectionDetailsCommand}" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Padding="14,8" Content="Open Tutorial" Click="OpenQuickTutorial_OnClick" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="Open SQLcl" Command="{Binding OpenOracleSqlclCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="Run Tutorial Query" Command="{Binding RunOracleTutorialQueryCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="Test Connection" Command="{Binding TestOracleConnectionCommand}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,12,0,0" Text="{Binding SqlDeveloperStatus}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrandTextSecondaryBrush}" Text="{Binding SqlDeveloperGuidance}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Padding="14,8" Content="Copy Connection" Command="{Binding CopyOracleConnectionDetailsCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="Open SQL Developer" Command="{Binding OpenSqlDeveloperCommand}" IsEnabled="{Binding IsSqlDeveloperDetected}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrandTextSecondaryBrush}" Text="Staging is optional for onboarding. Keep future staging access read-only and limit it to query workflows." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource BrandSurfaceSubtleBrush}" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding SafetyTitle}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding SelectedWorkspaceSafetyStatus}" FontWeight="SemiBold" ToolTip="{Binding SelectedWorkspaceSafetyStatusHelpText}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedWorkspaceSafetyMessage}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedWorkspaceSafetyStatusHelpText}" TextWrapping="Wrap" Foreground="{StaticResource BrandTextSecondaryBrush}" />

                                    <TextBlock Margin="0,12,0,4" Text="{Binding LocalRecoveryLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WorkingCopyLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceWorkingCopy}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LatestSavePointLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceLatestSavePoint}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding LatestCheckpointLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceLatestCheckpoint}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding UncommittedChangesLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceUncommittedChanges}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding UntrackedFilesLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceUntrackedFiles}" TextWrapping="Wrap" />

                                    <TextBlock Margin="0,12,0,4" Text="{Binding BackupLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RemoteNameLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceRemoteName}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding RemoteBranchLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceRemoteBranch}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding AheadBehindLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceAheadBehind}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RemoteConfiguredLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceRemoteConfigured}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding UnpublishedSavePointsLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceUnpublishedSavePoints}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding WorkingCopyPublishedLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceWorkingCopyPublished}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding LastPublishLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceLastPublish}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding ConflictingFilesLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedWorkspaceConflictingFiles}" TextWrapping="Wrap" />

                                    <WrapPanel Margin="0,12,0,0" Visibility="{Binding ShowNoRemoteActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Padding="14,8" Content="{Binding ConfigureRemoteBackupLabel}" Command="{Binding ConfigureRemoteBackupCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding ExportBackupLabel}" Command="{Binding ExportBackupCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding DismissLabel}" Command="{Binding DismissSafetyNoticeCommand}" />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,12,0,0" Visibility="{Binding ShowUnpublishedSavePointActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Padding="14,8" Content="{Binding PublishLabel}" Command="{Binding PublishWorkspaceCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding ExportBackupLabel}" Command="{Binding ExportBackupCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding ContinueWorkingLabel}" Command="{Binding ContinueWorkingCommand}" />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,12,0,0" Visibility="{Binding ShowNeedsReviewActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Padding="14,8" Content="{Binding UpdateWorkspaceLabel}" Command="{Binding UpdateWorkspaceFromRemoteCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding PublishReviewWorkingCopyLabel}" Command="{Binding PublishReviewWorkingCopyCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding ExportPatchLabel}" Command="{Binding ExportPatchCommand}" />
                                        <Button Margin="8,0,0,0" Padding="14,8" Content="{Binding OpenAdvancedGitViewLabel}" Command="{Binding OpenAdvancedGitViewCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,12,0,4" Text="{Binding SelectedAgentLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkspaceAgent}" TextWrapping="Wrap" />

                            <TextBlock Margin="0,12,0,4" Text="{Binding EncodingValidationLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EncodingValidationSample}" TextWrapping="Wrap" />

                            <Border Margin="0,20,0,0" Padding="12" Background="{StaticResource BrandSurfaceSubtleBrush}" CornerRadius="8">
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowSelectionGuidanceState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                            <TextBlock Text="{Binding EmptySelectionTitle}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Margin="0,12,0,0" Text="{Binding EmptySelectionDescription}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                            <TextBlock Margin="0,16,0,0" Text="{Binding EmptySelectionHintPrimary}" TextAlignment="Center" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding EmptySelectionHintSecondary}" TextAlignment="Center" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0" Padding="12" Background="#FF222222" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Foreground="White" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <Border x:Name="LogAutoScrollPausedIndicator"
                            DockPanel.Dock="Right"
                            Visibility="Collapsed"
                            Background="#33F5C542"
                            CornerRadius="10"
                            Padding="8,3"
                            Margin="12,0,0,0">
                        <TextBlock Foreground="#FFF5C542" Text="Auto-scroll paused" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </DockPanel>

                <TextBox x:Name="LogTextBox"
                         Grid.Row="1"
                         Margin="0,12,0,0"
                         Text="{Binding CurrentLogText, Mode=OneWay}"
                         Background="#FF222222"
                         BorderThickness="0"
                         Foreground="White"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Loaded="LogTextBox_OnLoaded"
                         TextChanged="LogTextBox_OnTextChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>

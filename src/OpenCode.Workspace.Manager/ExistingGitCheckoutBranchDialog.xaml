<Window x:Class="OpenCode.Workspace.Manager.ExistingGitCheckoutBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Use Existing Git Checkout"
        Width="760"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/Icons/opencode-stuff-app.ico">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Use Existing Git Checkout" />
                <TextBlock Margin="0,8,0,0" Text="Choose how this workspace should branch before OpenCode writes workspace files into the repository folder." TextWrapping="Wrap" Foreground="{StaticResource BrandTextSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="14" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="10" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Detected repository" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding RepositoryPathSummary}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding CurrentBranchSummary}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding DefaultBranchSummary}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding RemoteOriginSummary}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding WorkspaceDefinitionSummary}" TextWrapping="Wrap" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding DirtyStatusSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding AheadBehindSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Padding="14" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="10" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Branch choice" FontSize="18" FontWeight="SemiBold" />
                            <RadioButton Margin="0,12,0,0" Content="Use current branch" IsChecked="{Binding UseCurrentBranch, Mode=OneWay}" Checked="UseCurrentBranch_OnChecked" />
                            <TextBlock Margin="24,4,0,0" Text="Keep working on the branch already checked out in this repository." TextWrapping="Wrap" Foreground="{StaticResource BrandTextSecondaryBrush}" />

                            <RadioButton Margin="0,14,0,0" Content="Create temporary workspace branch" IsChecked="{Binding CreateTemporaryWorkspaceBranch, Mode=OneWay}" Checked="CreateTemporaryWorkspaceBranch_OnChecked" />
                            <TextBlock Margin="24,4,0,0" Text="Recommended. Creates an isolated branch such as workspace/my-project-20260613-1430." TextWrapping="Wrap" Foreground="{StaticResource BrandTextSecondaryBrush}" />

                            <RadioButton Margin="0,14,0,0" Content="Create named feature branch" IsChecked="{Binding CreateNamedFeatureBranch, Mode=OneWay}" Checked="CreateNamedFeatureBranch_OnChecked" />
                            <TextBox Margin="24,6,0,0" Text="{Binding NamedBranch, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowNamedBranchInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="24,4,0,0" Text="Enter a branch name and OpenCode will validate it with Git before continuing." TextWrapping="Wrap" Foreground="{StaticResource BrandTextSecondaryBrush}" Visibility="{Binding ShowNamedBranchInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Width="120" Height="36" Style="{StaticResource PrimaryButtonStyle}" Content="Continue" Click="Continue_OnClick" />
                <Button DockPanel.Dock="Right" Width="100" Height="36" Margin="0,0,10,0" Content="Cancel" Click="Cancel_OnClick" />
            </DockPanel>
        </Grid>
    </Border>
</Window>

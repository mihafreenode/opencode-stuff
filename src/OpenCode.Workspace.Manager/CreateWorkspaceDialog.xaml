<Window x:Class="OpenCode.Workspace.Manager.CreateWorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding CreateWorkspaceDialogTitle}"
        Width="720"
        Height="820"
        MinWidth="660"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/Icons/opencode-stuff-app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20" Background="{StaticResource BrandSurfaceBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" MaxWidth="460">
                    <TextBlock Text="{Binding CreateWorkspaceDialogTitle}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding CreateWorkspaceDialogDescription}" TextWrapping="Wrap" Foreground="{StaticResource BrandTextSecondaryBrush}" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        x:Name="HeaderCreateButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="180"
                        Height="38"
                        Margin="16,0,0,0"
                        Content="{Binding CreateLabel}"
                        Click="Create_OnClick"
                        IsEnabled="{Binding CanCreateWorkspaceForDialog}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="{Binding CreateWorkspaceDisabledReason}"
                        IsDefault="True" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Padding="20">
                <Border Padding="16" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding NameLabel}" FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,0" Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,4,0,0" Foreground="#FFB91C1C" Text="{Binding WorkspaceNameValidationMessage}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,14,0,0" Text="Workspace source" FontWeight="SemiBold" />
                        <StackPanel Margin="0,6,0,0">
                            <RadioButton Content="Create new workspace" IsChecked="{Binding IsNewWorkspaceSource, Mode=OneWay}" Checked="NewWorkspaceSource_OnChecked" />
                            <RadioButton Margin="0,8,0,0" Content="Use existing Git checkout" IsChecked="{Binding IsExistingGitCheckoutSource, Mode=OneWay}" Checked="ExistingGitCheckoutSource_OnChecked" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsNewWorkspaceSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,14,0,0" Text="{Binding PathLabel}" FontWeight="SemiBold" />
                            <TextBox Margin="0,6,0,0" Text="{Binding NewWorkspacePath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Foreground="#FFB91C1C" Text="{Binding WorkspacePathValidationMessage}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsExistingGitCheckoutSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,14,0,0" Text="Existing repository" FontWeight="SemiBold" />
                            <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Width="110" Margin="10,0,0,0" Content="Browse..." Click="BrowseExistingRepository_OnClick" />
                                <TextBox Text="{Binding ExistingRepositoryPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Margin="0,4,0,0" Foreground="#FFB91C1C" Text="{Binding ExistingRepositoryPathValidationMessage}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrandTextSecondaryBrush}" Text="Workspace files stay inside the selected repository folder." TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowCatalogSelectionOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,14,0,0" Text="{Binding TemplateLabel}" FontWeight="SemiBold" />
                            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="DisplayName" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource BrandTextSecondaryBrush}" Text="When an existing Git checkout does not have workspace.yaml yet, these selections become the initial workspace tools." TextWrapping="Wrap" />

                            <Border Margin="0,14,0,0" Padding="14" Background="{StaticResource BrandSurfaceSubtleBrush}" CornerRadius="10" BorderThickness="1"
                                    Visibility="{Binding IsOracleDemoTemplateSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Oracle PL/SQL Demo" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,10,0,0" Text="Includes:" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding OracleTemplateIncludesSummary}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,14,0,0"
                                               Foreground="{StaticResource BrandTextSecondaryBrush}"
                                               Text="Use the primary Create Workspace button above to create this workspace."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,14,0,0" Text="{Binding FeaturesLabel}" FontWeight="SemiBold" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding AvailableFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,4,0,4" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanChangeSelection}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrandTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,14,0,0" Text="{Binding ServicesLabel}" FontWeight="SemiBold" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding AvailableServices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,4,0,4" IsChecked="{Binding IsSelected}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrandTextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0" Text="{Binding TerminalSettingsTitle}" FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Margin="0,10,0,0" Text="{Binding PromptLabel}" FontWeight="SemiBold" />
                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding PromptProviders}" SelectedItem="{Binding SelectedPromptProvider}" />

                        <TextBlock Margin="0,14,0,0" Text="{Binding FontLabel}" FontWeight="SemiBold" />
                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFontFamily}" />
                        <Button Margin="0,8,0,0" Padding="12,6" Content="{Binding InstallFontLabel}" Command="{Binding InstallSelectedFontCommand}" HorizontalAlignment="Left" />

                        <CheckBox Margin="0,14,0,0" IsChecked="{Binding InstallTerminalIfMissing}" Content="{Binding InstallIfMissingLabel}" />
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding InstallZoxide}" Content="{Binding ZoxideLabel}" />
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding InstallFzf}" Content="{Binding FzfLabel}" />
                    </StackPanel>
                </Border>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>

<Application x:Class="OpenCode.Workspace.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenCode.Workspace.Manager">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#FFF7F8FA" />
        <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BrandSurfaceSubtleBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="BrandBorderBrush" Color="#FFCBD2D9" />
        <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#FF1F2933" />
        <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#FF52606D" />
        <SolidColorBrush x:Key="BrandTextMutedBrush" Color="Gray" />
        <SolidColorBrush x:Key="BrandAccentBrush" Color="#FFF28C28" />
        <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="#FFE67E17" />
        <SolidColorBrush x:Key="BrandAccentPressedBrush" Color="#FFD96F09" />
        <SolidColorBrush x:Key="BrandAccentForegroundBrush" Color="#FF1F2933" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BrandBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{StaticResource BrandSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{StaticResource BrandSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{StaticResource BrandSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrandAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BrandAccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccentBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrandTextPrimaryBrush}" />
        </Style>

    </Application.Resources>
</Application>

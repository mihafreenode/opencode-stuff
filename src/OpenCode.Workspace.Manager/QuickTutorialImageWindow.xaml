<Window x:Class="OpenCode.Workspace.Manager.QuickTutorialImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ImageTitle}"
        Width="1400"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/Icons/opencode-stuff-app.ico">
    <Grid Background="{StaticResource BrandBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="20,20,20,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding ImageTitle}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Text="Mouse wheel zooms. Drag to inspect details when zoomed in." Foreground="{StaticResource BrandTextSecondaryBrush}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Width="110" Height="36" Content="Close" Click="Close_OnClick" />
        </DockPanel>

        <Border Grid.Row="1" Margin="20,0,20,20" Padding="10" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="12" BorderThickness="1">
            <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ImageScrollViewer_OnPreviewMouseWheel">
                <Grid Background="{StaticResource BrandSurfaceSubtleBrush}">
                    <Image x:Name="FullImage" Source="{Binding ImagePath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

<Window x:Class="OpenCode.Workspace.Manager.RemoveWorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/Icons/opencode-stuff-app.ico">
    <Border Padding="20">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DialogTitle}" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="{Binding DialogDescription}" />
            <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="10" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding WorkspaceLabel}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding WorkspaceName}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrandTextMutedBrush}" TextWrapping="Wrap" Text="{Binding WorkspacePath}" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="14" Background="{StaticResource BrandSurfaceBrush}" CornerRadius="10" BorderThickness="1">
                <StackPanel>
                    <RadioButton GroupName="RemovalChoice" IsChecked="True" Checked="RegistrationOnly_OnChecked">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding RegistrationOnlyTitle}" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrandTextMutedBrush}" Text="{Binding RegistrationOnlyFiles}" />
                            <TextBlock Foreground="{StaticResource BrandTextMutedBrush}" Text="{Binding RegistrationOnlyDocker}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Margin="0,14,0,0" GroupName="RemovalChoice" Checked="DockerResources_OnChecked">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding DockerResourcesTitle}" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrandTextMutedBrush}" Text="{Binding DockerResourcesDescription}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Margin="0,14,0,0" GroupName="RemovalChoice" Checked="DeleteFiles_OnChecked">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding DeleteFilesTitle}" />
                            <TextBlock Margin="0,4,0,0" Foreground="#FFB91C1C" Text="{Binding DeleteFilesDescription}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,20,0,0">
                <Button Width="110" Height="34" Content="{Binding CancelLabel}" Click="Cancel_OnClick" DockPanel.Dock="Right" />
                <Button Width="110" Height="34" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding ConfirmLabel}" Click="Confirm_OnClick" DockPanel.Dock="Right" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenCode.Workspace.Api\OpenCode.Workspace.Api.csproj" />
    <ProjectReference Include="..\..\src\OpenCode.Workspace.Cli\OpenCode.Workspace.Cli.csproj" />
    <ProjectReference Include="..\..\src\OpenCode.Workspace.Mcp\OpenCode.Workspace.Mcp.csproj" />
  </ItemGroup>

  <Target Name="CopyMcpHostOutput" AfterTargets="Build">
    <PropertyGroup>
      <McpHostOutputDir>$(MSBuildProjectDirectory)/../../src/OpenCode.Workspace.Mcp/bin/$(Configuration)/net10.0</McpHostOutputDir>
      <McpHostStagingDir>$(OutDir)mcp-host/</McpHostStagingDir>
    </PropertyGroup>

    <ItemGroup>
      <McpHostFiles Include="$(McpHostOutputDir)/**" />
    </ItemGroup>

    <MakeDir Directories="$(McpHostStagingDir)" />
    <Copy SourceFiles="@(McpHostFiles)"
          DestinationFiles="@(McpHostFiles->'$(McpHostStagingDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

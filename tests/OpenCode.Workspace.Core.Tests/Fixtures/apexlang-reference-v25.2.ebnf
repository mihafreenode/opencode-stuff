<component> ::= <app> | <page> | <rest-handler> | <legacy-banner>

<app> ::= "app" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <app-body-line> } <indent> ")" <line-end>
<app-child-component> ::= <page> | <rest-handler> | <legacy-banner>
<app-direct-property> ::= "name" : <ws> <string-like-value> (* required; type: TEXT; maxLen=128 *)
  | "alias" : <ws> <string-like-value> (* type: TEXT *)
  | "theme" : <ws> <string-like-value> (* type: TEXT *)

<page> ::= "page" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <page-body-line> } <indent> ")" <line-end>
<page-direct-property> ::= "name" : <ws> <string-like-value> (* required; type: TEXT *)
  | "alias" : <ws> <string-like-value> (* type: TEXT *)
  | "legacyTemplate" : <ws> <string-like-value> (* type: TEXT *)

<rest-handler> ::= "restHandler" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <rest-handler-body-line> } <indent> ")" <line-end>
<rest-handler-direct-property> ::= "name" : <ws> <string-like-value> (* required; type: TEXT *)
  | "method" : <ws> <string-like-value> (* enum=[GET, POST, TRACE] *)

<legacy-banner> ::= "legacyBanner" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <legacy-banner-body-line> } <indent> ")" <line-end>
<legacy-banner-direct-property> ::= "title" : <ws> <string-like-value> (* type: TEXT *)
